<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Styles.ThemeForgeDefaults">
    <!-- ========================= -->
    <!-- Semantic colors defaults -->
    <!-- ========================= -->

    <Color x:Key="Theme.Color.Primary">#1976D2</Color>
    <Color x:Key="Theme.Color.OnPrimary">#FFFFFF</Color>

    <Color x:Key="Theme.Color.Secondary">#42A5F5</Color>
    <Color x:Key="Theme.Color.OnSecondary">#000000</Color>

    <Color x:Key="Theme.Color.Tertiary">#0D47A1</Color>
    <Color x:Key="Theme.Color.OnTertiary">#FFFFFF</Color>

    <Color x:Key="Theme.Color.Background">#FFFFFF</Color>
    <Color x:Key="Theme.Color.OnBackground">#1F1F1F</Color>

    <Color x:Key="Theme.Color.Surface">#FFFFFF</Color>
    <Color x:Key="Theme.Color.OnSurface">#1F1F1F</Color>

    <Color x:Key="Theme.Color.SurfaceVariant">#F5F5F5</Color>
    <Color x:Key="Theme.Color.OnSurfaceVariant">#5F6368</Color>

    <Color x:Key="Theme.Color.Outline">#DADCE0</Color>
    <Color x:Key="Theme.Color.OutlineVariant">#E8EAED</Color>
    <Color x:Key="Theme.Color.Disabled">#E0E0E0</Color>

    <Color x:Key="Theme.Color.TextPrimary">#1F1F1F</Color>
    <Color x:Key="Theme.Color.TextSecondary">#5F6368</Color>
    <Color x:Key="Theme.Color.TextDisabled">#9AA0A6</Color>

    <Color x:Key="Theme.Color.IconPrimary">#1F1F1F</Color>
    <Color x:Key="Theme.Color.IconSecondary">#5F6368</Color>
    <Color x:Key="Theme.Color.IconDisabled">#9AA0A6</Color>

    <Color x:Key="Theme.Color.Error">#D32F2F</Color>
    <Color x:Key="Theme.Color.OnError">#FFFFFF</Color>

    <Color x:Key="Theme.Color.Success">#2E7D32</Color>
    <Color x:Key="Theme.Color.Warning">#F57C00</Color>
    <Color x:Key="Theme.Color.Info">#1976D2</Color>

    <!-- ========================= -->
    <!-- Semantic brushes defaults -->
    <!-- ========================= -->

    <SolidColorBrush x:Key="Theme.Brush.Primary" Color="{StaticResource Theme.Color.Primary}" />
    <SolidColorBrush x:Key="Theme.Brush.Secondary" Color="{StaticResource Theme.Color.Secondary}" />
    <SolidColorBrush x:Key="Theme.Brush.Tertiary" Color="{StaticResource Theme.Color.Tertiary}" />

    <SolidColorBrush x:Key="Theme.Brush.Background" Color="{StaticResource Theme.Color.Background}" />
    <SolidColorBrush x:Key="Theme.Brush.Surface" Color="{StaticResource Theme.Color.Surface}" />
    <SolidColorBrush x:Key="Theme.Brush.SurfaceVariant" Color="{StaticResource Theme.Color.SurfaceVariant}" />

    <SolidColorBrush x:Key="Theme.Brush.Outline" Color="{StaticResource Theme.Color.Outline}" />
    <SolidColorBrush x:Key="Theme.Brush.Disabled" Color="{StaticResource Theme.Color.Disabled}" />

    <SolidColorBrush x:Key="Theme.Brush.Error" Color="{StaticResource Theme.Color.Error}" />
    <SolidColorBrush x:Key="Theme.Brush.Success" Color="{StaticResource Theme.Color.Success}" />
    <SolidColorBrush x:Key="Theme.Brush.Warning" Color="{StaticResource Theme.Color.Warning}" />
    <SolidColorBrush x:Key="Theme.Brush.Info" Color="{StaticResource Theme.Color.Info}" />

    <!-- ========================= -->
    <!-- Typography defaults -->
    <!-- ========================= -->

    <x:String x:Key="Theme.Font.Family.Body"></x:String>
    <x:String x:Key="Theme.Font.Family.Title"></x:String>
    <x:String x:Key="Theme.Font.Family.Caption"></x:String>

    <x:Double x:Key="Theme.Font.Size.Body">14</x:Double>
    <x:Double x:Key="Theme.Font.Size.Title">18</x:Double>
    <x:Double x:Key="Theme.Font.Size.Caption">12</x:Double>

    <x:Boolean x:Key="Theme.Font.Bold.Body">False</x:Boolean>
    <x:Boolean x:Key="Theme.Font.Bold.Title">True</x:Boolean>
    <x:Boolean x:Key="Theme.Font.Bold.Caption">False</x:Boolean>

    <x:Boolean x:Key="Theme.Font.Italic.Body">False</x:Boolean>
    <x:Boolean x:Key="Theme.Font.Italic.Title">False</x:Boolean>
    <x:Boolean x:Key="Theme.Font.Italic.Caption">False</x:Boolean>

    <x:Boolean x:Key="Theme.Font.Strikethrough.Body">False</x:Boolean>
    <x:Boolean x:Key="Theme.Font.Strikethrough.Title">False</x:Boolean>
    <x:Boolean x:Key="Theme.Font.Strikethrough.Caption">False</x:Boolean>

    <x:Boolean x:Key="Theme.Font.Underline.Body">False</x:Boolean>
    <x:Boolean x:Key="Theme.Font.Underline.Title">False</x:Boolean>
    <x:Boolean x:Key="Theme.Font.Underline.Caption">False</x:Boolean>

    <x:String x:Key="Theme.Font.StrikethroughStyle.Body">Solid</x:String>
    <x:String x:Key="Theme.Font.StrikethroughStyle.Title">Solid</x:String>
    <x:String x:Key="Theme.Font.StrikethroughStyle.Caption">Solid</x:String>

    <x:String x:Key="Theme.Font.UnderlineStyle.Body">Solid</x:String>
    <x:String x:Key="Theme.Font.UnderlineStyle.Title">Solid</x:String>
    <x:String x:Key="Theme.Font.UnderlineStyle.Caption">Solid</x:String>

    <!-- ========================= -->
    <!-- Global geometry defaults -->
    <!-- ========================= -->

    <x:Double x:Key="Theme.Geometry.CornerRadius">8</x:Double>
    <x:Double x:Key="Theme.Geometry.BorderThickness">1</x:Double>
    <x:Double x:Key="Theme.Geometry.Padding">12</x:Double>
    <x:Double x:Key="Theme.Geometry.Margin">8</x:Double>

    <x:Boolean x:Key="Theme.Geometry.HasShadow">False</x:Boolean>
    <x:Double x:Key="Theme.Geometry.ShadowRadius">4</x:Double>
    <x:Double x:Key="Theme.Geometry.ShadowOpacity">0.18</x:Double>
    <x:Double x:Key="Theme.Geometry.Elevation">0</x:Double>

    <!-- ========================= -->
    <!-- Control geometry defaults -->
    <!-- ========================= -->

    <x:Double x:Key="Theme.Control.Button.CornerRadius">8</x:Double>
    <x:Double x:Key="Theme.Control.Button.BorderThickness">0</x:Double>
    <x:Double x:Key="Theme.Control.Button.Padding">12</x:Double>

    <x:Double x:Key="Theme.Control.Entry.CornerRadius">6</x:Double>
    <x:Double x:Key="Theme.Control.Entry.BorderThickness">1</x:Double>
    <x:Double x:Key="Theme.Control.Entry.Padding">10</x:Double>

    <x:Double x:Key="Theme.Control.Editor.CornerRadius">6</x:Double>
    <x:Double x:Key="Theme.Control.Editor.BorderThickness">1</x:Double>
    <x:Double x:Key="Theme.Control.Editor.Padding">10</x:Double>

    <x:Double x:Key="Theme.Control.Slider.TrackThickness">4</x:Double>
    <x:Double x:Key="Theme.Control.Slider.ThumbDiameter">16</x:Double>

    <x:Double x:Key="Theme.Control.Switch.IndicatorSize">20</x:Double>
    <x:Double x:Key="Theme.Control.CheckBox.IndicatorSize">18</x:Double>
    <x:Double x:Key="Theme.Control.RadioButton.IndicatorSize">18</x:Double>

    <x:Double x:Key="Theme.Control.Card.CornerRadius">12</x:Double>
    <x:Double x:Key="Theme.Control.Card.Padding">12</x:Double>

    <!-- ========================= -->
    <!-- Base control styles -->
    <!-- ========================= -->

    <Style x:Key="ThemeForge.Button" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Theme.Brush.Primary}" />
        <Setter Property="TextColor" Value="{DynamicResource Theme.Color.OnPrimary}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Theme.Control.Button.CornerRadius}" />
        <Setter Property="BorderWidth" Value="{DynamicResource Theme.Control.Button.BorderThickness}" />
        <Setter Property="BorderColor" Value="{DynamicResource Theme.Color.Outline}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Font.Size.Body}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.Font.Family.Body}" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Theme.Color.Disabled}" />
                            <Setter Property="TextColor" Value="{DynamicResource Theme.Color.TextDisabled}" />
                            <Setter Property="Opacity" Value="0.62" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ThemeForge.Label" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Theme.Color.TextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Font.Size.Body}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.Font.Family.Body}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="ThemeForge.TitleLabel" TargetType="Label" BasedOn="{StaticResource ThemeForge.Label}">
        <Setter Property="FontSize" Value="{DynamicResource Theme.Font.Size.Title}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.Font.Family.Title}" />
    </Style>

    <Style x:Key="ThemeForge.CaptionLabel" TargetType="Label" BasedOn="{StaticResource ThemeForge.Label}">
        <Setter Property="FontSize" Value="{DynamicResource Theme.Font.Size.Caption}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.Font.Family.Caption}" />
        <Setter Property="TextColor" Value="{DynamicResource Theme.Color.TextSecondary}" />
    </Style>

    <Style x:Key="ThemeForge.Entry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{DynamicResource Theme.Brush.Surface}" />
        <Setter Property="TextColor" Value="{DynamicResource Theme.Color.TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Theme.Color.TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Font.Size.Body}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.Font.Family.Body}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Theme.Color.Disabled}" />
                            <Setter Property="TextColor" Value="{DynamicResource Theme.Color.TextDisabled}" />
                            <Setter Property="Opacity" Value="0.62" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ThemeForge.Editor" TargetType="Editor">
        <Setter Property="BackgroundColor" Value="{DynamicResource Theme.Brush.Surface}" />
        <Setter Property="TextColor" Value="{DynamicResource Theme.Color.TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Theme.Color.TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Font.Size.Body}" />
        <Setter Property="FontFamily" Value="{DynamicResource Theme.Font.Family.Body}" />
    </Style>

    <Style x:Key="ThemeForge.Switch" TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Theme.Color.Primary}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Theme.Color.OnPrimary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.55" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ThemeForge.CheckBox" TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource Theme.Color.Primary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.55" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ThemeForge.RadioButton" TargetType="RadioButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.55" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ThemeForge.Slider" TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Theme.Color.Primary}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource Theme.Color.Outline}" />
        <Setter Property="ThumbColor" Value="{DynamicResource Theme.Color.Primary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="MinimumTrackColor" Value="{DynamicResource Theme.Color.Disabled}" />
                            <Setter Property="MaximumTrackColor" Value="{DynamicResource Theme.Color.OutlineVariant}" />
                            <Setter Property="ThumbColor" Value="{DynamicResource Theme.Color.Disabled}" />
                            <Setter Property="Opacity" Value="0.72" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ThemeForge.ProgressBar" TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource Theme.Color.Primary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Theme.Color.OutlineVariant}" />
    </Style>

    <Style x:Key="ThemeForge.Picker" TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource Theme.Color.TextPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource Theme.Color.TextSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Theme.Brush.Surface}" />
        <Setter Property="FontSize" Value="{DynamicResource Theme.Font.Size.Body}" />
    </Style>
</ResourceDictionary>