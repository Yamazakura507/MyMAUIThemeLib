<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ThemeForge.Maui.Controls.Components.Tree;assembly=ThemeForge.Maui.Controls"
             xmlns:preview="clr-namespace:ThemeForge.Maui.Controls.Components.Preview;assembly=ThemeForge.Maui.Controls"
             x:Class="ThemeForge.Maui.Studio.Pages.ThemesPreviewPage"
             Title="ThemeForge Preview">

    <Grid RowDefinitions="*,320">
        <controls:ThemeTreeView
            Grid.Row="0"
            BindingContext="{Binding ThemeTree}" />

        <preview:ThemePreviewSurface
            Grid.Row="1"
            Theme="{Binding SelectedTheme}"
            Mode="{Binding PreviewMode}" />
    </Grid>
</ContentPage>