<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThemeForge.Maui.Studio.Components.ComponentThemeEditor"
             xmlns:editors="clr-namespace:ThemeForge.Maui.Studio.ComponentModels.Editors"
             xmlns:mauiConv="clr-namespace:ThemeForge.Maui.Converters;assembly=ThemeForge.Maui"
             x:DataType="editors:ComponentThemeEditorViewModel">
    <ContentView.Resources>
        <mauiConv:HexToColorConverter x:Key="HexToColor" />
    </ContentView.Resources>

    <VerticalStackLayout Spacing="8" Padding="8">
        <Label
            Text="{Binding Title}"
            FontAttributes="Bold" />

        <Label Text="Foreground" />
        <Entry
            Text="{Binding ForegroundHex, Mode=TwoWay}"
            Placeholder="#RRGGBB" />

        <Label Text="Background" />
        <Entry
            Text="{Binding BackgroundHex, Mode=TwoWay}"
            Placeholder="#RRGGBB" />

        <Label Text="Border" />
        <Entry
            Text="{Binding BorderHex, Mode=TwoWay}"
            Placeholder="#RRGGBB" />

        <Border
            Stroke="{Binding BorderHex, Converter={StaticResource HexToColor}}"
            BackgroundColor="{Binding BackgroundHex, Converter={StaticResource HexToColor}}"
            StrokeThickness="1"
            Padding="12"
            HeightRequest="56">
            <Label
                Text="Sample"
                TextColor="{Binding ForegroundHex, Converter={StaticResource HexToColor}}"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Border>
    </VerticalStackLayout>
</ContentView>
