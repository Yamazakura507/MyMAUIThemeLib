<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThemeForge.Maui.Controls.Components.Lottie.ThemeBackgroundHost"
             xmlns:skia="clr-namespace:ThemeForge.Maui.Controls.ComponentModels.Skia"
             xmlns:lottie="clr-namespace:ThemeForge.Maui.Controls.ComponentModels.Lottie"
             x:DataType="hosts:ThemeBackgroundHost"
             xmlns:hosts="clr-namespace:ThemeForge.Maui.Controls.Components.Lottie">
    <Grid>
        <skia:EffectCanvas
            x:Name="SkiaCanvas"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            BackgroundColor="Transparent" />

        <lottie:LottieEffectView
            x:Name="LottieHost"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            BackgroundColor="Transparent"
            IsVisible="False" />
    </Grid>
</ContentView>
