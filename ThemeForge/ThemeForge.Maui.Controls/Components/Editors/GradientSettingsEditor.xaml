<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThemeForge.Maui.Controls.Components.Editors.GradientSettingsEditor"
             xmlns:editors="clr-namespace:ThemeForge.Maui.Controls.ComponentModels.Editors"
             xmlns:helpers="clr-namespace:ThemeForge.Maui.Controls.Helpers"
             x:DataType="editors:GradientSettingsEditorViewModel">

    <VerticalStackLayout Spacing="8">
        <Picker
            Title="Тип градиента"
            ItemsSource="{Binding Types}"
            SelectedItem="{Binding Type, Mode=TwoWay}" />

        <HorizontalStackLayout Spacing="8">
            <Label Text="Цвета:" VerticalOptions="Center" />
            <Stepper
                Minimum="2"
                Maximum="4"
                Value="{Binding ColorCount, Mode=TwoWay}" />
            <Label Text="{Binding ColorCount}" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <CollectionView ItemsSource="{Binding Stops}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="editors:GradientStopViewModel">
                    <Grid ColumnDefinitions="*,120" Padding="0,4">
                        <Entry
                            Grid.Column="0"
                            Text="{Binding Hex, Mode=TwoWay}"
                            Placeholder="#HEX" />
                        <Label
                            Grid.Column="1"
                            Text="{Binding Offset, StringFormat='{0:F2}'}"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="Геометрия" FontAttributes="Bold" />

        <HorizontalStackLayout IsVisible="{Binding Type, Converter={x:Static helpers:GradientTypeVisibility.IsLinear}}">
            <Label Text="Угол" VerticalOptions="Center" />
            <Slider
                Minimum="0"
                Maximum="360"
                Value="{Binding AngleDegrees, Mode=TwoWay}"
                WidthRequest="180" />
        </HorizontalStackLayout>

        <Grid ColumnDefinitions="*,*" IsVisible="{Binding Type, Converter={x:Static helpers:GradientTypeVisibility.IsRadial}}">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Center X" />
                <Slider Minimum="0" Maximum="1" Value="{Binding CenterX, Mode=TwoWay}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1">
                <Label Text="Center Y" />
                <Slider Minimum="0" Maximum="1" Value="{Binding CenterY, Mode=TwoWay}" />
            </VerticalStackLayout>
        </Grid>

        <HorizontalStackLayout IsVisible="{Binding Type, Converter={x:Static helpers:GradientTypeVisibility.IsRadial}}">
            <Label Text="Radius" VerticalOptions="Center" />
            <Slider
                Minimum="0.1"
                Maximum="2"
                Value="{Binding Radius, Mode=TwoWay}"
                WidthRequest="180" />
        </HorizontalStackLayout>

        <Label Text="Эффект" FontAttributes="Bold" />

        <HorizontalStackLayout>
            <Label Text="Включить" VerticalOptions="Center" />
            <Switch IsToggled="{Binding EffectEnabled, Mode=TwoWay}" />
        </HorizontalStackLayout>

        <Picker
            Title="Тип эффекта"
            ItemsSource="{Binding EffectKinds}"
            SelectedItem="{Binding EffectKind, Mode=TwoWay}"
            IsEnabled="{Binding EffectEnabled}" />

        <HorizontalStackLayout IsEnabled="{Binding EffectEnabled}">
            <Label Text="Intensity" VerticalOptions="Center" />
            <Slider
                Minimum="0"
                Maximum="1"
                Value="{Binding EffectIntensity, Mode=TwoWay}"
                WidthRequest="140" />
        </HorizontalStackLayout>

        <HorizontalStackLayout IsEnabled="{Binding EffectEnabled}">
            <Label Text="Speed" VerticalOptions="Center" />
            <Slider
                Minimum="0.1"
                Maximum="3"
                Value="{Binding EffectSpeed, Mode=TwoWay}"
                WidthRequest="140" />
        </HorizontalStackLayout>

        <VerticalStackLayout
            Spacing="6"
            IsVisible="{Binding IsLottieEffect}"
            IsEnabled="{Binding EffectEnabled}">

            <Label Text="Lottie" FontAttributes="Bold" />

            <Label Text="Локальный asset" />
            <Entry
                Placeholder="Animations/loading.json"
                Text="{Binding LottieAssetName, Mode=TwoWay}" />

            <Label Text="URL" />
            <Entry
                Placeholder="https://example.com/animation.json"
                Text="{Binding LottieUrl, Mode=TwoWay}" />

            <HorizontalStackLayout Spacing="12">
                <CheckBox IsChecked="{Binding LottieLoop, Mode=TwoWay}" />
                <Label Text="Loop" VerticalOptions="Center" />

                <CheckBox IsChecked="{Binding LottieAutoPlay, Mode=TwoWay}" />
                <Label Text="AutoPlay" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Tint color" />
            <Entry
                Placeholder="#FFFFFF"
                Text="{Binding LottieTintColorHex, Mode=TwoWay}" />

            <Label Text="Scale mode" />
            <Picker
                ItemsSource="{Binding LottieScaleModes}"
                SelectedItem="{Binding LottieScaleMode, Mode=TwoWay}" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
