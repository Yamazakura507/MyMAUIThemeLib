<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThemeForge.Maui.Controls.Components.Editors.GradientThemeEditor"
             xmlns:editorsModel="clr-namespace:ThemeForge.Maui.Controls.ComponentModels.Editors"
             xmlns:editors="clr-namespace:ThemeForge.Maui.Controls.Components.Editors"
             x:DataType="editorsModel:GradientThemeEditorViewModel">
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="8">
            <Label Text="Градиентная тема" FontAttributes="Bold" />

            <editors:GradientSettingsEditor
                BindingContext="{Binding Settings}" />

            <Button
                Text="Собрать тему"
                Command="{Binding BuildCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
