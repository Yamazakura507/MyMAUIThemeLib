<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThemeForge.Maui.Controls.Components.Editors.GeometryEditor"
             xmlns:editors="clr-namespace:ThemeForge.Maui.Controls.ComponentModels.Editors"
             x:DataType="editors:GeometryEditorViewModel">
    <ScrollView>
        <VerticalStackLayout Spacing="8" Padding="8">
            <Label Text="Геометрия" FontAttributes="Bold" />

            <HorizontalStackLayout>
                <Label Text="CornerRadius" WidthRequest="130" VerticalOptions="Center" />
                <Slider Minimum="0" Maximum="32" Value="{Binding CornerRadius, Mode=TwoWay}" WidthRequest="160" />
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <Label Text="BorderThickness" WidthRequest="130" VerticalOptions="Center" />
                <Slider Minimum="0" Maximum="8" Value="{Binding BorderThickness, Mode=TwoWay}" WidthRequest="160" />
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <Label Text="Padding" WidthRequest="130" VerticalOptions="Center" />
                <Slider Minimum="0" Maximum="32" Value="{Binding Padding, Mode=TwoWay}" WidthRequest="160" />
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <Label Text="Margin" WidthRequest="130" VerticalOptions="Center" />
                <Slider Minimum="0" Maximum="32" Value="{Binding Margin, Mode=TwoWay}" WidthRequest="160" />
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <Label Text="ThumbDiameter" WidthRequest="130" VerticalOptions="Center" />
                <Slider Minimum="8" Maximum="32" Value="{Binding ThumbDiameter, Mode=TwoWay}" WidthRequest="160" />
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <Label Text="TrackThickness" WidthRequest="130" VerticalOptions="Center" />
                <Slider Minimum="1" Maximum="16" Value="{Binding TrackThickness, Mode=TwoWay}" WidthRequest="160" />
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <Label Text="IndicatorSize" WidthRequest="130" VerticalOptions="Center" />
                <Slider Minimum="8" Maximum="32" Value="{Binding IndicatorSize, Mode=TwoWay}" WidthRequest="160" />
            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <CheckBox IsChecked="{Binding HasShadow, Mode=TwoWay}" />
                <Label Text="HasShadow" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout IsEnabled="{Binding HasShadow}">
                <Label Text="ShadowRadius" WidthRequest="130" VerticalOptions="Center" />
                <Slider Minimum="0" Maximum="24" Value="{Binding ShadowRadius, Mode=TwoWay}" WidthRequest="160" />
            </HorizontalStackLayout>

            <HorizontalStackLayout IsEnabled="{Binding HasShadow}">
                <Label Text="ShadowOpacity" WidthRequest="130" VerticalOptions="Center" />
                <Slider Minimum="0" Maximum="1" Value="{Binding ShadowOpacity, Mode=TwoWay}" WidthRequest="160" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
