<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMAUIUIThemeLibTester.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="16"
            Spacing="12"
            BackgroundColor="{DynamicResource Theme.Brush.Background}">

            <Label
                Text="ThemeForge preview"
                Style="{StaticResource ThemeForge.TitleLabel}" />

            <Label
                Text="Secondary text"
                Style="{StaticResource ThemeForge.CaptionLabel}" />

            <Button
                Text="Primary button"
                Style="{StaticResource ThemeForge.Button}" />

            <Entry
                Placeholder="Entry"
                Style="{StaticResource ThemeForge.Entry}" />

            <Switch
                IsToggled="True"
                Style="{StaticResource ThemeForge.Switch}" />

            <Slider
                Value="0.5"
                Style="{StaticResource ThemeForge.Slider}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
