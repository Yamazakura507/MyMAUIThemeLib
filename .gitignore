# ==========================================
# 4. NuGet и зависимости
# ==========================================
# Папки с загруженными пакетами (для старых форматов)
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Временные файлы NuGet
*.nuget.props
*.nuget.targets
*.nupkg
*.snupkg

# ==========================================
# 5. Секреты, сертификаты и ключи
# ==========================================
# ВАЖНО: Никогда не коммитьте приватные ключи и сертификаты подписи!
*.pfx
*.keystore
*.key
*.publishsettings
*.jks

# ==========================================
# 6. Системные файлы ОС
# ==========================================
# macOS
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==========================================
# 7. Исключения (файлы, которые НУЖНО коммитить)
